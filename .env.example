# Copy this file to .env and fill in the required values.

# Required: BotFather token for your private bot.
TELEGRAM_BOT_TOKEN=

# Required: your numeric Telegram user id (the only user allowed to use the bot).
OWNER_ID=

# Optional: default model for new sessions — a Claude Code CLI alias, resolved by the CLI:
# "default" (the model Claude Code recommends for the account) or a family (opus / sonnet / …,
# always its newest model); a pinned id also works. The /model picker lists what the CLI offers.
DEFAULT_MODEL=default

# Optional: daily time (UTC, HH:MM) the bot runs `claude update` and moves sessions onto a new
# CLI version without cutting a reply (idle ones at once, busy ones after their answer).
# "off" = never. Also adjustable in Settings → Admin → CLI update.
# CLI_UPDATE_AT_UTC=12:00

# Optional (experimental): name the model, its version and effort on the first line of the
# animated "Thinking…" indicator. 0 = off.
# THINKING_MODEL_LINE=1

# Optional: Telegram holds a message sent while a reply draft streams. The draft carries
# Telegram's stop button; here pressing it PUSHES the held message into the running reply (the
# reply goes on). all | owner | off.
# DRAFT_PUSH=all
# Withdrawn experiment (default off — every cycle raised a notification): land and delete a tiny
# message every DRAFT_RELEASE_SECS while only the "Thinking…" indicator shows. owner | all | off.
# DRAFT_RELEASE=off
# DRAFT_RELEASE_SECS=3

# Optional: MAX (max.ru) messenger. Set the bot token from business.max.ru to serve the
# same bot on MAX too (long polling; off when empty). MAX users get their own identity
# space: sessions, allowlist entries and usage never overlap with Telegram's, and the
# owner's MAX account is an ordinary user to allow — admin (owner commands, access
# requests, tool approvals) stays on Telegram. Replies on MAX are sent whole once ready
# (no draft streaming); a "Thinking…" message stands in meanwhile.
# MAX_BOT_TOKEN=
# The platform API host is signed by the Russian Trusted Root CA, bundled at
# deploy/certs/russian_trusted_root_ca.pem and trusted by the MAX client only. Point
# MAX_CA_BUNDLE at another PEM, or set "system" if the OS store already trusts it.
# MAX_API_BASE=https://platform-api2.max.ru
# MAX_CA_BUNDLE=

# Optional: base directory for per-thread code-mode working dirs (created if missing).
BASE_WORKDIR=./workdirs

# Optional: SQLite database file for per-thread state and usage.
DB_PATH=./bot.db

# Don't set ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN).
# The Agent SDK spawns the claude CLI, which must use your logged-in
# Pro/Max SUBSCRIPTION credentials. Any ANTHROPIC_API_KEY present would
# force paid API billing instead of the subscription.
# Log in once on the host with:  claude setup-token   (or interactive claude login)

# Optional: path to the JSON allowlist of permitted users. This file is
# gitignored and lists the users allowed to use the bot (the owner is always
# allowed regardless of its contents).
ALLOWLIST_PATH=./allowlist.json

# Optional: extra prompt keyword triggers to neutralize, ON TOP of the built-in
# defaults (ultrathink, ultracode). List MORE words here (comma- or
# space-separated) to render them inert too. Leave unset for defaults.
# BLOCKED_PROMPT_KEYWORDS=

# Optional: per-code-session sandbox. ON by default — set
# SANDBOX_CODE=0 to disable. SANDBOX_UID = the unprivileged uid the jail drops to.
# SANDBOX_CODE=1
# SANDBOX_UID=65534
