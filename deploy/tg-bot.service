# Systemd unit for reliable 24/7 bot operation.
# - Install by copying to /etc/systemd/system; adjust paths
# - Run as the user that ran setup-token
# - Never set ANTHROPIC_API_KEY; subscription billing only
# - Restart=always, no start limit, 180s notify watchdog

[Unit]
Description=Claude Telegram Bot (private Telegram frontend to Claude / Claude Code)
After=network-online.target
Wants=network-online.target
# Never stop restarting, surviving long outages.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# Restart if Telegram is unreachable this long.
# - App pings the watchdog after each successful probe
# - Must be at least twice the probe cadence
WatchdogSec=180
# Generous start timeout; READY=1 is sent before network I/O.
# - Flaky startup links must not cause restart loops
TimeoutStartSec=300
TimeoutStopSec=60
# On stop, SIGTERM only the main bot process.
# - Lets the bot drain in-flight turns gracefully
# - Stragglers are SIGKILLed after TimeoutStopSec
KillMode=mixed

User=root
WorkingDirectory=/root/Projects/tgbot
# Run the app package via python -m app.
# - WorkingDirectory puts the repo root on sys.path
ExecStart=/root/Projects/tgbot/.venv/bin/python -m app

# The .env file is read from WorkingDirectory by python-dotenv.
# - Systemd inherits no login PATH or HOME
# - Set them so the claude CLI and creds are found
# - HOME must be the user that ran setup-token
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

Restart=always
RestartSec=5
# Raise if big code-mode runs get OOM-killed.
MemoryMax=2G

# Optional hardening; enable incrementally and verify code mode.
# - Sandbox needs user namespaces; bwrap is not setuid
# - Keep ~/.claude and workdirs writable
# - Uncomment only after testing

[Install]
WantedBy=multi-user.target
