# Optional timer: daily clean restart of the bot.
# - OnCalendar uses system timezone; 04:00 is low-traffic
# - RandomizedDelaySec spreads the restart slightly
# - Persistent=true runs a missed restart after downtime

[Unit]
Description=Daily clean restart of the Claude Telegram Bot

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
