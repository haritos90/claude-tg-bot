# Optional periodic clean restart of the bot.
# - Insurance against slow leaks and stale claude auth
# - Long-lived subprocess auth can go stale and return 401
# - Install together with the matching timer unit
# - try-restart never starts a deliberately stopped bot

[Unit]
Description=Periodic clean restart of the Claude Telegram Bot

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl try-restart claude-tg-bot.service
